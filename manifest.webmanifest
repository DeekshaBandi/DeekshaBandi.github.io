{
  "id": "./",
  "name": "Markdown & Diagram Viewer",
  "short_name": "Markdown Viewer",
  "description": "View and edit Markdown with Mermaid, D2 and Graphviz diagrams and LaTeX math. Renders locally.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f5f7fb",
  "theme_color": "#8b3dff",
  "icons": [
    { "src": "icons/icon192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "text/markdown": [".md", ".markdown", ".mdown", ".mkd"] },
      "launch_type": "multiple-clients"
    }
  ]
}
